# ============================================================================
# peptivaLab self-host — copy to .env and replace every CHANGEME value.
# Generate strong values:  openssl rand -hex 32   /   openssl rand -base64 24
# ============================================================================

# --- Public domains (point DNS A records at this server) -------------------
SITE_DOMAIN=peptivalab.se
WWW_DOMAIN=www.peptivalab.se
CHAT_DOMAIN=chat.peptivalab.se
STUDIO_DOMAIN=db.peptivalab.se
LETSENCRYPT_EMAIL=admin@peptivalab.se

# --- Postgres / Supabase ---------------------------------------------------
POSTGRES_PASSWORD=CHANGEME_strong_pg_password
JWT_SECRET=CHANGEME_min_32_chars_random_hex
# Generate ANON_KEY and SERVICE_ROLE_KEY from JWT_SECRET using
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=CHANGEME_jwt_anon_token
SERVICE_ROLE_KEY=CHANGEME_jwt_service_role_token
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGEME_studio_login_password

# Public Supabase URL the BROWSER hits (used to inject VITE_SUPABASE_URL at build)
PUBLIC_SUPABASE_URL=https://db.peptivalab.se

# --- App runtime -----------------------------------------------------------
ADMIN_CHAT_PASSWORD=CHANGEME_admin_panel_password

# --- IRC stack -------------------------------------------------------------
IRC_OPER_PASSWORD=CHANGEME_oper_password
IRC_SERVER_PASSWORD=CHANGEME_server_pass
GATEWAY_TOKEN=CHANGEME_shared_with_app
IRC_BOT_NICK=pvl-bot
IRC_CHANNEL_PREFIX=#pvl-

# --- Backups ---------------------------------------------------------------
# Cron expression (UTC). Default: every day at 03:17.
BACKUP_CRON=17 3 * * *
# Days to keep dumps before pruning.
BACKUP_RETENTION_DAYS=14
# Encrypt backups at rest with GPG AES-256 (symmetric).
# STRONGLY RECOMMENDED. Generate passphrases with:  openssl rand -base64 48
#
# KEY ROTATION:
#   - BACKUP_ENCRYPTION_KEY_ID is a short label (k0, k1, k2, ...) embedded in
#     each filename so you can tell which passphrase opens which dump.
#   - To rotate: bump KEY_ID + PASSPHRASE to the new values, AND move the OLD
#     pair into BACKUP_OLD_KEYS so historical dumps remain decryptable.
#   - Then optionally run:  docker compose exec backup rotate-keys.sh
#     to re-encrypt every existing dump with the new key, after which you can
#     safely remove the old entry from BACKUP_OLD_KEYS.
#   - Store ALL passphrases off the server (password manager). Without them
#     the dumps are unrecoverable.
#
# Leave KEY_ID + PASSPHRASE blank to write plaintext .sql.gz (not recommended).
BACKUP_ENCRYPTION_KEY_ID=k1
BACKUP_ENCRYPTION_PASSPHRASE=CHANGEME_long_random_passphrase
# Old keys, decrypt-only. Format: id:passphrase pairs, comma-separated.
# Example after one rotation:  BACKUP_OLD_KEYS=k0:previous_long_passphrase
BACKUP_OLD_KEYS=

# Weekly restore drill — restores the latest dump into a throwaway Postgres
# and runs smoke queries. Default: Sundays 04:43 UTC.
BACKUP_VERIFY_CRON=43 4 * * 0

# --- Off-site backup upload (optional, STRONGLY recommended) ---------------
# rclone destination, e.g. "b2:peptivalab-backups" or "s3:my-bucket/peptivalab".
# Leave empty to keep dumps on this VPS only (risky — fire/disk loss = data loss).
OFFSITE_REMOTE=
# Literal contents of an rclone.conf, multiline. Generate locally with
#   rclone config
# then paste the resulting INI block (newlines preserved).
# Example for Backblaze B2:
#   [b2]
#   type = b2
#   account = <keyID>
#   key = <applicationKey>
RCLONE_CONFIG=

# --- Analytics (optional) --------------------------------------------------
# Set to your Plausible site domain to inject the script. Empty = no analytics.
# Build-time only: rebuild the app container after changing.
VITE_PLAUSIBLE_DOMAIN=
# Override only if you self-host Plausible.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Public site URL (used by sitemap.xml + robots.txt) --------------------
PUBLIC_SITE_URL=https://peptivalab.se

# --- Email notifications (optional) ----------------------------------------
# Used by:
#   - Contact form on /kontakt  (sends each submission to NOTIFY_EMAIL_TO)
#   - Backup container          (sends an alert if a backup or verify fails)
#
# Leave SMTP_HOST empty to disable all email. The contact form still works,
# but no email is sent and backup failures are only visible in the logs.
#
# Works with any SMTP provider — Gmail (app password), Brevo, Postmark,
# Mailgun, Fastmail, SendGrid, your own Postfix, etc.
#
# Examples:
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Gmail:    SMTP_HOST=smtp.gmail.com         SMTP_PORT=587  (use app password)
#   Postmark: SMTP_HOST=smtp.postmarkapp.com   SMTP_PORT=587
#
# Change NOTIFY_EMAIL_TO any time — it's read fresh on each send. Just edit
# the .env, then `docker compose up -d app backup` to apply.
SMTP_HOST=
SMTP_PORT=587
# Leave SMTP_SECURE empty to auto-pick (true if port=465, otherwise false/STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender header. Should be on a domain you control (and ideally verified at
# your SMTP provider) so messages don't land in spam.
NOTIFY_EMAIL_FROM=PeptivaLab <noreply@peptivalab.se>
# Where notifications are delivered. Comma-separated for multiple recipients.
# >>> Put your real address here whenever you're ready. <<<
NOTIFY_EMAIL_TO=

# Shared token used by the backup container to POST alert emails to the app's
# internal /api/internal/notify endpoint. Required for backup-failure emails.
# Generate with:  openssl rand -hex 32
INTERNAL_NOTIFY_TOKEN=

# Email subject lines and message bodies are EDITABLE in the admin UI under
# /admin/innehall → "Mailmallar". No env var needed — change them any time
# without redeploying.


# ----------------------------------------------------------------------------
# Admin 2FA (TOTP)
# ----------------------------------------------------------------------------
# Optional. When set, the admin login form requires a 6-digit code from an
# authenticator app (Aegis, 1Password, Google Authenticator, etc.) in
# addition to the password. Leave empty to disable 2FA.
#
# Generate the secret in the app at /admin/sakerhet (after logging in once),
# scan the QR code, then paste the Base32 secret here and restart the app.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_ISSUER=PeptivaLab
ADMIN_TOTP_ACCOUNT=admin
