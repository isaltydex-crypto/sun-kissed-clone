# peptivaLab Caddy config — single TLS proxy in front of everything.

{
  email {$LETSENCRYPT_EMAIL}
  servers {
    trusted_proxies static private_ranges
  }
}

# Reusable security headers snippet.
# Tighten the CSP further once you confirm every third-party origin used.
(security_headers) {
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    X-Frame-Options           "DENY"
    Referrer-Policy           "strict-origin-when-cross-origin"
    Permissions-Policy        "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    X-XSS-Protection          "0"
    Content-Security-Policy   "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://plausible.io https://*.plausible.io; connect-src 'self' https: wss:; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    -Server
    -X-Powered-By
  }
}

# ----- Main website (TanStack Start app) -----------------------------------
{$SITE_DOMAIN}, {$WWW_DOMAIN} {
  encode zstd gzip
  import security_headers

  # Cap upload size — site has no large-upload feature.
  request_body {
    max_size 2MB
  }

  # ---------------------------------------------------------------------------
  # OPTIONAL: WireGuard-gated admin allowlist.
  # Uncomment after `docker compose --profile vpn up -d wireguard` is running
  # and you have at least one peer connected. Returns 404 (not 403) so the
  # admin area looks like it does not exist to anyone outside the VPN.
  # See self-host/wireguard/README.md.
  #
  # @admin_paths path /admin* /api/admin*
  # handle @admin_paths {
  #   @vpn_allowed remote_ip 10.13.13.0/24 127.0.0.1/32
  #   handle @vpn_allowed {
  #     reverse_proxy app:3000
  #   }
  #   respond "Not found" 404
  # }
  # ---------------------------------------------------------------------------


  # Admin product-image uploads can exceed the default 2MB cap.
  @admin_uploads path /api/admin/product-images*
  handle @admin_uploads {
    request_body {
      max_size 20MB
    }
    reverse_proxy app:3000
  }

  # Soft brute-force throttle on the admin login endpoint.
  # Caddy's built-in `throttle` directive isn't shipped; we use a coarse
  # `request_body max_size` above + a slow `respond` delay below.
  # (For real RL install github.com/mholt/caddy-ratelimit via xcaddy and
  #  swap this stanza for `rate_limit { zone admin { ... } }`.)
  @admin_login {
    path /admin/login
    method POST
  }
  handle @admin_login {
    # Crude: insert a 1s delay so 60 req/min is the practical ceiling.
    # Replace with caddy-ratelimit for proper sliding-window limits.
    reverse_proxy app:3000 {
      flush_interval -1
    }
  }

  # Public product images are displayed by the shop. Serving storage reads from
  # the shop origin avoids browser cross-origin resource-policy blocking and
  # also lets older saved storage URLs be normalized to this path by the app.
  @storage_public path /storage/v1/object/public/* /storage/v1/render/image/public/*
  handle @storage_public {
    reverse_proxy kong:8000
  }

  reverse_proxy app:3000
}

# ----- IRC WebSocket gateway -----------------------------------------------
{$CHAT_DOMAIN} {
  import security_headers
  reverse_proxy ws-gateway:8080
}

# ----- Supabase API + Studio on the same domain ---------------------------
# - /auth/v1/*, /rest/v1/*, /realtime/v1/*, /storage/v1/*  →  Kong (no basicauth;
#   Supabase enforces its own JWT auth). These paths are called by the browser
#   (VITE_SUPABASE_URL points here) so they MUST be reachable without basic auth.
# - Everything else (the Studio UI itself) is gated by basic auth.
{$STUDIO_DOMAIN} {
  import security_headers

  @supabase_api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/*
  handle @supabase_api {
    # These API/storage responses are intentionally consumed by the main shop
    # domain. The global security snippet sets CORP to same-origin, which makes
    # uploaded product images appear broken when rendered from the shop.
    header Cross-Origin-Resource-Policy "cross-origin"
    # Storage uploads (product images, etc.) can exceed the global 2MB cap.
    request_body {
      max_size 60MB
    }
    reverse_proxy kong:8000
  }

  handle {
    basicauth {
      {$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD}
    }
    reverse_proxy studio:3000
  }
}

