# Copy to .env and fill in.

# Used by /oper to gain operator privileges in IRC.
IRC_OPER_PASSWORD=change-me-oper

# Server password. Every IRC client (including the gateway) must send this
# via PASS on connect.
IRC_SERVER_PASSWORD=change-me-server

# Shared secret between the Lovable site and the ws-gateway.
# Set IRC_BOT_PASSWORD on the Lovable project to the same value.
GATEWAY_TOKEN=change-me-gateway

# Public hostname of the IRC server (must match the cert Caddy issued).
# Caddy must already be serving https://$CHAT_DOMAIN so a cert exists.
CHAT_DOMAIN=chat.yourdomain.com

# Name of Caddy's data volume on this host. Find it with:
#   docker volume ls | grep caddy_data
# Typically self-host_caddy_data.
CADDY_DATA_VOLUME=self-host_caddy_data
